# Banco Postgres (Neon). Use a conexão com pooler aqui...
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# ...e a conexão direta (sem -pooler) aqui, usada para criar as tabelas.
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinar a sessão. Gere um valor aleatório longo para produção.
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Provedor de pagamento: "mock" simula o Pix (botão "Simular pagamento").
# Depois: "mercadopago", "asaas" ou "pagarme".
PAYMENT_PROVIDER="mock"

# Senha da conta admin criada pelo seed. Sem ela, o admin usa a senha de teste do README.
ADMIN_PASSWORD="troque-esta-senha"

# Taxa da Nexo em pontos-base (990 = 9,9%).
NEXO_FEE_BPS="990"
