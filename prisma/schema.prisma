// Banco de dados da Nexo.
// Postgres (Neon). DATABASE_URL usa a conexão com pooler (-pooler no endereço)
// e DIRECT_URL a conexão direta, usada só para criar as tabelas (db push).
// Valores em dinheiro são sempre centavos (Int) para evitar erro de arredondamento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  username          String       @unique
  passwordHash      String
  bio               String       @default("")
  balanceCents      Int          @default(0) // saldo disponível para saque
  role              String       @default("USER") // USER | ADMIN
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime? // sessões criadas antes disso deixam de valer
  emailTokens       EmailToken[]
  createdAt         DateTime     @default(now())

  // Suspensão pela equipe: a pessoa não entra e os anúncios somem.
  suspendedAt   DateTime?
  suspendReason String    @default("")

  // Verificação de vendedor (exigida para sacar).
  fullName         String  @default("")
  cpf              String? @unique
  birthDate        String  @default("")
  verification     String  @default("NAO_ENVIADO") // NAO_ENVIADO | PENDENTE | APROVADO | RECUSADO
  verificationNote String  @default("")

  // Login em duas etapas (TOTP, app autenticador). Obrigatório para admin.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  reports Report[]

  // Perfil público e reputação (contadores atualizados a cada venda e avaliação).
  storeName      String  @default("")
  avatarId       String?
  // Loja: capa (Image CAPA) e horário de atendimento informado pelo vendedor.
  storeBannerId  String?
  storeHours     String  @default("")
  completedSales Int     @default(0)
  ratingSum      Int     @default(0)
  ratingCount    Int     @default(0)

  notifications    Notification[]
  pushSubs         PushSubscription[]
  titles           UserTitle[]
  // Convite (indicação): quem trouxe esta pessoa ganha 2% de cada pedido concluído dela, pago da taxa da Nexo.
  referredById     String?
  referredBy       User?              @relation("referrals", fields: [referredById], references: [id])
  referrals        User[]             @relation("referrals")
  referralEarnings ReferralEarning[]
  boosts           Boost[]
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  savedAlerts      SavedAlert[]
  questions        Question[]
  images           Image[]

  listings         Listing[]
  purchases        Order[]       @relation("buyer")
  sales            Order[]       @relation("seller")
  messages         Message[]
  reviewsGiven     Review[]      @relation("author")
  reviewsReceived  Review[]      @relation("sellerReviews")
  favorites        Favorite[]
  withdrawals      Withdrawal[]
  adminActions     AdminAction[]
  wanted           Wanted[]
  wantedOffers     WantedOffer[]
  reservedListings Listing[]     @relation("reservedFor")

  following          StoreFollow[]      @relation("follower")
  followers          StoreFollow[]      @relation("followed")
  proposalsSold      Proposal[]         @relation("proposalSeller")
  proposalsBought    Proposal[]         @relation("proposalBuyer")
  externalProfiles   ExternalProfile[]  @relation("externalOwner")
  externalReviewed   ExternalProfile[]  @relation("externalReviewer")
  storeCoupons       StoreCoupon[]
  sellerProgram      SellerProgram?     @relation("programSeller")
  programsOwned      SellerProgram[]    @relation("programOwner")
  commissionPolicies CommissionPolicy[]
}

model Game {
  slug     String    @id
  name     String
  letter   String // letra exibida em "Escolha seu universo"
  glyph    String // texto grande na arte dos cards
  c1       String // cor de brilho
  c2       String // cor de fundo
  sort     Int       @default(0)
  listings Listing[]
  wanted   Wanted[]
}

model Listing {
  id             String           @id @default(cuid())
  sellerId       String
  seller         User             @relation(fields: [sellerId], references: [id])
  gameSlug       String
  game           Game             @relation(fields: [gameSlug], references: [slug])
  type           String // CONTA | MOEDA | ITEM | GIFT | SERVICO
  title          String
  description    String
  glyph          String?
  priceCents     Int
  oldPriceCents  Int?
  stock          Int
  autoDelivery   Boolean          @default(false)
  featured       Boolean          @default(false)
  status         String           @default("ATIVO") // ATIVO | PAUSADO | REMOVIDO (pela moderação)
  moderationNote String           @default("") // motivo da remoção, visível para o vendedor
  soldCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  // Órbita (destaque pago): até esta data o anúncio aparece no topo da página inicial e da busca.
  orbitUntil     DateTime?
  boosts         Boost[]
  viewDays       ListingViewDay[]
  // Anúncio criado de uma oferta aceita em "Quero comprar": só esse comprador vê e compra.
  reservedForId  String?
  reservedFor    User?            @relation("reservedFor", fields: [reservedForId], references: [id])
  // Servidor/região do jogo (opcional), usado no filtro da loja.
  server         String           @default("")
  // Anúncio criado ao aceitar uma proposta por link (também reservado ao comprador).
  proposalId     String?          @unique
  proposal       Proposal?        @relation(fields: [proposalId], references: [id])

  codes     AutoCode[]
  orders    Order[]
  favorites Favorite[]
  reports   Report[]
  images    Image[]
  questions Question[]

  @@index([gameSlug])
  @@index([type])
  @@index([sellerId])
  @@index([orbitUntil])
}

// Códigos para entrega automática (gift cards, recargas). Um por unidade.
model AutoCode {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  code      String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([listingId, orderId])
}

// Ciclo do pedido (Garantia Nexo):
// AGUARDANDO_PAGAMENTO -> PAGO -> ENTREGUE -> CONCLUIDO
//                           \--------\-> DISPUTA -> CONCLUIDO (admin libera ao vendedor)
//                                               \-> REEMBOLSADO (admin devolve ao comprador)
// AGUARDANDO_PAGAMENTO -> CANCELADO (Pix expirou ou comprador cancelou)
model Order {
  id                 String    @id @default(cuid())
  code               String    @unique
  buyerId            String
  buyer              User      @relation("buyer", fields: [buyerId], references: [id])
  sellerId           String
  seller             User      @relation("seller", fields: [sellerId], references: [id])
  listingId          String
  listing            Listing   @relation(fields: [listingId], references: [id])
  quantity           Int
  unitPriceCents     Int
  totalCents         Int
  feeCents           Int
  status             String    @default("AGUARDANDO_PAGAMENTO")
  buyerNote          String    @default("") // ex.: ID do jogador para recargas
  deliveryText       String    @default("")
  disputeReason      String    @default("")
  paymentId          String?
  pixCode            String?
  pixExpiresAt       DateTime?
  paidAt             DateTime?
  deliveredAt        DateTime?
  autoConfirmAt      DateTime?
  completedAt        DateTime?
  disputedAt         DateTime?
  resolution         String    @default("") // decisão do mediador, visível para as duas partes
  resolvedAt         DateTime?
  refundedAt         DateTime?
  refundId           String?
  discountCents      Int       @default(0) // desconto de cupom, pago pela Nexo (o vendedor recebe sobre o preço cheio)
  couponCode         String?
  // Plano de proteção do comprador (BASICO | VIP | PREMIUM) e forma de pagamento (PIX | SALDO | CARTAO).
  // planCents e cardFeeCents entram no totalCents (o que o comprador paga) e ficam com a Nexo, não com o vendedor.
  plan               String    @default("BASICO")
  planCents          Int       @default(0)
  cardFeeCents       Int       @default(0)
  payMethod          String    @default("PIX")
  paymentUrl         String? // página segura do Asaas para pagar com cartão
  cashbackCents      Int       @default(0) // devolvido em saldo ao concluir (planos VIP)
  // Origem da venda e comissão fixadas na criação do pedido (docs/lojas-vendedor.md).
  // origin: MARKETPLACE | LINK_VENDEDOR. feeBps e policyId vazios = pedidos anteriores à política.
  origin             String    @default("MARKETPLACE")
  feeBps             Int?
  policyId           String?
  // Proposta por link: condições aceitas pelo comprador, copiadas (JSON) para o pedido.
  proposalId         String?
  terms              String    @default("")
  // Cupom da loja: o desconto sai do vendedor (diferente do cupom da Nexo, pago pela plataforma).
  storeCouponId      String?
  storeDiscountCents Int       @default(0)
  createdAt          DateTime  @default(now())

  messages Message[]
  review   Review?

  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String? // null = mensagem do sistema
  sender    User?    @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  authorId  String
  author    User     @relation("author", fields: [authorId], references: [id])
  sellerId  String
  seller    User     @relation("sellerReviews", fields: [sellerId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amountCents Int
  pixKey      String
  status      String    @default("PENDENTE") // PENDENTE | PROCESSANDO (Pix saindo) | PAGO | RECUSADO
  note        String    @default("") // motivo da recusa
  payoutId    String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Registro de tudo que um admin faz (auditoria).
model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  kind      String // DISPUTA_LIBERADA | DISPUTA_REEMBOLSADA | SAQUE_PAGO | SAQUE_RECUSADO | ANUNCIO_REMOVIDO | ANUNCIO_RESTAURADO
  targetId  String
  label     String // descrição curta para a lista (ex.: "#NX-12345")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Denúncia de anúncio feita por um usuário. 3 denúncias abertas tiram o anúncio do ar até a análise.
model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  details    String   @default("")
  status     String   @default("ABERTA") // ABERTA | PROCEDENTE | DESCARTADA
  createdAt  DateTime @default(now())

  @@unique([listingId, reporterId])
  @@index([status])
}

// Tentativas de login, para bloquear quem tenta adivinhar senhas.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Foto enviada por usuário, servida por /api/imagens/<id>.
model Image {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind      String // ANUNCIO | AVATAR
  mime      String
  size      Int
  data      Bytes // o arquivo em si (a Vercel não guarda arquivos em disco)
  thumb     Bytes? // miniatura WEBP de até 480 px, para cards e listas
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId, sort])
}

model Question {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId    String
  asker      User      @relation(fields: [askerId], references: [id])
  body       String
  answer     String    @default("")
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([listingId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  href      String    @default("/")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Cupom da Nexo: o desconto sai da receita da plataforma.
model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  percentOff       Int       @default(0) // 10 = 10%
  amountOffCents   Int       @default(0)
  maxDiscountCents Int? // teto para cupons percentuais
  minOrderCents    Int       @default(0)
  maxUses          Int?
  uses             Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

// Links enviados por e-mail (confirmar e-mail, redefinir senha). Guarda só o hash do token.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // VERIFY | RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

// "Quero comprar": o comprador publica o que procura e os vendedores mandam ofertas.
// Oferta aceita vira um anúncio reservado ao comprador e segue o checkout normal (Garantia Nexo).
model Wanted {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  gameSlug    String
  game        Game     @relation(fields: [gameSlug], references: [slug])
  type        String // CONTA | MOEDA | ITEM | GIFT | SERVICO
  title       String
  description String
  maxCents    Int
  status      String   @default("ABERTO") // ABERTO | FECHADO (oferta aceita) | CANCELADO
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  offers WantedOffer[]

  @@index([status, expiresAt])
  @@index([buyerId])
}

model WantedOffer {
  id         String   @id @default(cuid())
  wantedId   String
  wanted     Wanted   @relation(fields: [wantedId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id])
  priceCents Int
  message    String
  status     String   @default("ENVIADA") // ENVIADA | ACEITA | RECUSADA
  listingId  String? // anúncio reservado criado ao aceitar
  createdAt  DateTime @default(now())

  @@unique([wantedId, sellerId])
}

// Celular ou navegador que aceitou receber notificações (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Títulos dados pela equipe (ex.: "Parceiro oficial") ou automáticos (ex.: Fundador, os 20 primeiros vendedores).
// Aparecem ao lado do nível do vendedor nos cards, anúncios e loja.
model Title {
  id          String      @id @default(cuid())
  name        String      @unique
  emoji       String      @default("🏅")
  color       String      @default("#C5F04A") // cor do selo (#RRGGBB)
  description String      @default("")
  auto        String?     @unique // FUNDADOR = concedido sozinho pelo site
  maxHolders  Int? // limite de pessoas com o título (Fundador: 20)
  createdAt   DateTime    @default(now())
  holders     UserTitle[]
}

model UserTitle {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId     String
  title       Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  grantedById String? // admin que deu; vazio = automático
  createdAt   DateTime @default(now())

  @@id([userId, titleId])
  @@index([titleId, createdAt])
}

// Comissão de convite paga em um pedido concluído. Uma por pedido e lado (comprador ou vendedor convidado).
model ReferralEarning {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  orderId     String
  side        String // COMPRA | VENDA: o convidado foi o comprador ou o vendedor do pedido
  amountCents Int
  createdAt   DateTime @default(now())

  @@unique([orderId, side])
  @@index([referrerId, createdAt])
}

// Órbita: o vendedor paga com o saldo para o anúncio aparecer no topo por alguns dias.
model Boost {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  days        Int
  amountCents Int
  endsAt      DateTime // fim da Órbita depois desta compra (somado ao tempo que ainda faltava)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Chat com o suporte. Uma conversa aberta por pessoa; a equipe responde em /admin/suporte.
model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String // PEDIDO | PAGAMENTO | CONTA | VENDER | OUTRO
  orderCode String?
  status    String           @default("ABERTO") // ABERTO | FECHADO
  waiting   Boolean          @default(true) // true = a última mensagem é do cliente (a equipe precisa responder)
  lastAt    DateTime         @default(now())
  closedAt  DateTime?
  createdAt DateTime         @default(now())
  messages  SupportMessage[]

  @@index([status, waiting, lastAt])
  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String? // null = mensagem automática do Nexinho
  sender    User?         @relation(fields: [senderId], references: [id])
  staff     Boolean       @default(false) // escrita por alguém da equipe
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// "Me avise quando aparecer": filtros salvos da busca. Anúncio novo que combina gera um aviso.
model SavedAlert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSlug  String?
  type      String?
  q         String    @default("")
  maxCents  Int?
  hits      Int       @default(0)
  lastHitAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([gameSlug])
}

// Visitas por dia de cada anúncio (painel do vendedor). day = AAAA-MM-DD no horário de Brasília.
model ListingViewDay {
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       String
  count     Int     @default(0)

  @@id([listingId, day])
  @@index([day])
}

// Política de comissão. Cada alteração do admin cria uma versão nova; a ativa é a mais recente.
// O pedido guarda a versão usada (Order.policyId), então mudar a política não altera vendas antigas.
model CommissionPolicy {
  id             String   @id @default(cuid())
  standardFeeBps Int // comissão normal (marketplace)
  linkFeeBps     Int? // comissão reduzida para vendas vindas do link do vendedor
  linkEnabled    Boolean  @default(false)
  windowHours    Int      @default(0) // janela de atribuição; 0 = não definida
  // Custos estimados, só para a simulação do admin (não mudam cobranças).
  pixCostCents   Int      @default(0)
  pixCostBps     Int      @default(0)
  otherCostCents Int      @default(0)
  note           String   @default("")
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Pontos de contato entre um navegador/conta e um vendedor (origem da venda).
model AttributionTouch {
  id        String   @id @default(cuid())
  visitorId String // cookie aleatório nexo_vid
  userId    String?
  sellerId  String
  source    String // LINK_VENDEDOR | MARKETPLACE
  listingId String?
  createdAt DateTime @default(now())

  @@index([sellerId, visitorId, createdAt])
  @@index([sellerId, userId, createdAt])
}

// Proposta por link: negociação combinada fora da Nexo e paga com a Garantia Nexo.
model Proposal {
  id              String    @id @default(cuid())
  token           String    @unique // código aleatório do link
  sellerId        String
  seller          User      @relation("proposalSeller", fields: [sellerId], references: [id])
  buyerId         String? // vinculado ao primeiro comprador que aceitar
  buyer           User?     @relation("proposalBuyer", fields: [buyerId], references: [id])
  gameSlug        String
  server          String    @default("")
  type            String
  title           String
  description     String
  quantity        Int       @default(1)
  totalCents      Int
  deliveryDays    Int
  deliveryTerms   String
  expiresAt       DateTime
  status          String    @default("ABERTA") // ABERTA | ACEITA | PAGA | CANCELADA
  version         Int       @default(1)
  acceptedVersion Int?
  acceptedAt      DateTime?
  orderId         String?
  listing         Listing?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sellerId, createdAt])
  @@index([buyerId])
}

model StoreFollow {
  followerId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation("followed", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, sellerId])
  @@index([sellerId])
}

// Cupom criado pelo vendedor para a própria loja. O desconto sai do valor dele.
model StoreCoupon {
  id               String           @id @default(cuid())
  sellerId         String
  seller           User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code             String
  percentOff       Int              @default(0)
  amountOffCents   Int              @default(0)
  maxDiscountCents Int?
  minOrderCents    Int              @default(0)
  maxUses          Int?
  uses             Int              @default(0) // pedidos em aberto ou pagos que usam o cupom
  scope            String           @default("LOJA") // LOJA | JOGO | ANUNCIO
  target           String           @default("") // slug do jogo ou id do anúncio
  startsAt         DateTime?
  expiresAt        DateTime?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  usesBy           StoreCouponUse[]

  @@unique([sellerId, code])
}

// Uso de cupom da loja: um por comprador (trava no banco). Apagado se o pedido for cancelado.
model StoreCouponUse {
  id        String      @id @default(cuid())
  couponId  String
  coupon    StoreCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  buyerId   String
  orderId   String?     @unique
  createdAt DateTime    @default(now())

  @@unique([couponId, buyerId])
}

// Perfil do vendedor em outra plataforma. A equipe confere o código de verificação no perfil externo.
model ExternalProfile {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("externalOwner", fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  url        String
  handle     String    @default("")
  challenge  String // código que o vendedor coloca na bio/descrição do perfil externo
  status     String    @default("PENDENTE") // PENDENTE | APROVADO | RECUSADO | REVOGADO
  note       String    @default("")
  reviewerId String?
  reviewer   User?     @relation("externalReviewer", fields: [reviewerId], references: [id])
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

// Programa de primeiros vendedores: acompanhamento interno da equipe (nada disso é público).
model SellerProgram {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation("programSeller", fields: [userId], references: [id], onDelete: Cascade)
  ownerId       String?
  owner         User?    @relation("programOwner", fields: [ownerId], references: [id])
  status        String   @default("CONTATO") // CONTATO | ONBOARDING | PRIMEIRA_VENDA | CONCLUIDO | PAUSADO
  notes         String   @default("")
  stepListings  Boolean  @default(false)
  stepStore     Boolean  @default(false)
  stepMaterial  Boolean  @default(false)
  stepFirstSale Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
